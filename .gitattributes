# Normalize line endings for text files in this ASP.NET project
* text=auto

# Force CRLF on checkout for Windows-specific text files
*.aspx text eol=crlf
*.aspx.cs text eol=crlf
*.aspx.designer.cs text eol=crlf
*.master text eol=crlf
*.master.cs text eol=crlf
*.master.designer.cs text eol=crlf
*.cs text eol=crlf
*.config text eol=crlf
*.xml text eol=crlf
*.css text eol=crlf
*.js text eol=crlf
*.json text eol=crlf
*.txt text eol=crlf
